@page "/backtest"
@attribute [Authorize]
@inject IBacktestService BacktestSvc

<PageTitle>Backtest - TradePerso</PageTitle>

<MudText Typo="Typo.h4" Class="page-title">Backtest</MudText>

<MudPaper Class="pa-4 metric-card mb-3">
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="3"><MudTextField id="backtest-ticker" @bind-Value="_ticker" Label="Ticker" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
        <MudItem xs="6" sm="3"><MudDatePicker id="backtest-start" @bind-Date="_start" Label="Start" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
        <MudItem xs="6" sm="3"><MudDatePicker id="backtest-end" @bind-Date="_end" Label="End" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
        <MudItem xs="6" sm="3"><MudNumericField id="backtest-monthly-contribution" T="decimal" @bind-Value="_monthly" Label="Monthly contribution" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
        <MudItem xs="6" sm="3"><MudNumericField id="backtest-initial-cash" T="decimal" @bind-Value="_initial" Label="Initial cash" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
        <MudItem xs="12" sm="3" Class="d-flex align-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RunAsync" FullWidth="true">Run</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_running)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_result is not null)
{
    <MudGrid Spacing="3">
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4 metric-card">
                <MudText Typo="Typo.overline">DCA invested</MudText>
                <MudText Typo="Typo.h6" Class="kpi">@_result.Metrics.DcaInvested.ToString("N2")</MudText>
                <MudText Class="mt-2">Final: @_result.Metrics.DcaFinalValue.ToString("N2")</MudText>
                <MudText>CAGR: @_result.Metrics.DcaCagr.ToString("P2")</MudText>
                <MudText>Max DD: @_result.Metrics.DcaMaxDrawdown.ToString("P1")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4 metric-card">
                <MudText Typo="Typo.overline">70/20/10 mix</MudText>
                <MudText Typo="Typo.h6" Class="kpi">@_result.Metrics.MixedFinalValue.ToString("N2")</MudText>
                <MudText Class="mt-2">CAGR: @_result.Metrics.MixedCagr.ToString("P2")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4 metric-card">
                <MudText Typo="Typo.overline">Lump sum</MudText>
                <MudText Typo="Typo.h6" Class="kpi">@_result.Metrics.LumpSumFinalValue.ToString("N2")</MudText>
                <MudText Class="mt-2">CAGR: @_result.Metrics.LumpSumCagr.ToString("P2")</MudText>
            </MudPaper>
        </MudItem>
        @if (_capitalSeries.Count > 0)
        {
            <MudItem xs="12">
                <MudPaper Class="pa-4 metric-card">
                    <MudText Typo="Typo.h6" Class="mb-2">Simulated capital curve</MudText>
                    <MudChart ChartType="ChartType.Line"
                              ChartSeries="@_capitalSeries"
                              XAxisLabels="@_chartLabels"
                              Width="100%"
                              Height="360px"
                              ChartOptions="@_lineChartOptions"
                              CanHideSeries="true" />
                </MudPaper>
            </MudItem>
            <MudItem xs="12">
                <MudPaper Class="pa-4 metric-card">
                    <MudText Typo="Typo.h6" Class="mb-2">@_ticker.ToUpperInvariant() price history</MudText>
                    <MudChart ChartType="ChartType.Line"
                              ChartSeries="@_priceSeries"
                              XAxisLabels="@_chartLabels"
                              Width="100%"
                              Height="280px"
                              ChartOptions="@_priceChartOptions" />
                </MudPaper>
            </MudItem>
        }
        <MudItem xs="12">
            <MudPaper Class="pa-2 metric-card">
                <MudTable Items="_result.Curve" Dense="true" Hover="true" Height="380px" FixedHeader="true" Virtualize="true">
                    <HeaderContent>
                        <MudTh>Date</MudTh><MudTh>Price</MudTh><MudTh>Invested</MudTh><MudTh>DCA</MudTh><MudTh>70/20/10</MudTh><MudTh>Lump sum</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Date</MudTd>
                        <MudTd>@context.InstrumentPrice.ToString("N2")</MudTd>
                        <MudTd>@context.InvestedCapital.ToString("N2")</MudTd>
                        <MudTd>@context.DcaCurve.ToString("N2")</MudTd>
                        <MudTd>@context.MixedCurve.ToString("N2")</MudTd>
                        <MudTd>@context.LumpSumCurve.ToString("N2")</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudItem>
        @if (_result.Warnings.Count > 0)
        {
            <MudItem xs="12">
                <MudAlert Severity="Severity.Warning">@string.Join(" ", _result.Warnings)</MudAlert>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private string _ticker = "VUSA.L";
    private DateTime? _start = DateTime.UtcNow.AddYears(-5);
    private DateTime? _end = DateTime.UtcNow;
    private decimal _monthly = 500m;
    private decimal _initial = 1000m;
    private BacktestResultDto? _result;
    private bool _running;
    private string[] _chartLabels = Array.Empty<string>();
    private List<ChartSeries> _capitalSeries = new();
    private List<ChartSeries> _priceSeries = new();

    private readonly ChartOptions _lineChartOptions = new()
    {
        LineStrokeWidth = 3,
        MaxNumYAxisTicks = 6
    };

    private readonly ChartOptions _priceChartOptions = new()
    {
        LineStrokeWidth = 3,
        MaxNumYAxisTicks = 5,
        DisableLegend = true
    };

    private async Task RunAsync()
    {
        if (string.IsNullOrWhiteSpace(_ticker) || _start is null || _end is null) return;
        _running = true;
        _result = await BacktestSvc.RunAsync(
            _ticker.Trim().ToUpperInvariant(),
            DateOnly.FromDateTime(_start.Value),
            DateOnly.FromDateTime(_end.Value),
            _monthly, _initial);
        BuildChartData(_result);
        _running = false;
    }

    private void BuildChartData(BacktestResultDto result)
    {
        var points = Sample(result.Curve, 90);
        _chartLabels = points
            .Select((p, i) => ChartLabel(p.Date, i, points.Count))
            .ToArray();

        _capitalSeries = new List<ChartSeries>
        {
            new() { Name = "DCA", Data = points.Select(p => D(p.DcaCurve)).ToArray() },
            new() { Name = "70/20/10", Data = points.Select(p => D(p.MixedCurve)).ToArray() },
            new() { Name = "Lump sum", Data = points.Select(p => D(p.LumpSumCurve)).ToArray() },
            new() { Name = "Capital invested", Data = points.Select(p => D(p.InvestedCapital)).ToArray() },
        };

        _priceSeries = new List<ChartSeries>
        {
            new() { Name = "Price", Data = points.Select(p => D(p.InstrumentPrice)).ToArray() },
        };
    }

    private static IReadOnlyList<BacktestPointDto> Sample(IReadOnlyList<BacktestPointDto> points, int maxPoints)
    {
        if (points.Count <= maxPoints) return points;

        var step = (int)Math.Ceiling(points.Count / (double)maxPoints);
        return points
            .Where((_, index) => index % step == 0 || index == points.Count - 1)
            .ToList();
    }

    private static string ChartLabel(DateOnly date, int index, int count)
    {
        var interval = Math.Max(1, count / 8);
        return index == 0 || index == count - 1 || index % interval == 0
            ? date.ToString("yyyy-MM")
            : string.Empty;
    }

    private static double D(decimal value) => decimal.ToDouble(value);
}
