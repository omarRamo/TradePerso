@page "/settings"
@attribute [Authorize]
@inject Application.Abstractions.Repositories.IUserSettingsRepository SettingsRepo
@inject CurrentUserAccessor CurrentUser
@inject ISnackbar Snackbar

<PageTitle>Settings - TradePerso</PageTitle>

<MudText Typo="Typo.h4" Class="page-title">Settings</MudText>

@if (_s is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudPaper Class="pa-4 metric-card">
        <MudGrid Spacing="3">
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.h6" Class="mb-2">Capital</MudText>
                <MudNumericField id="settings-total-capital" T="decimal" @bind-Value="_s.CapitalTotal" Label="Total capital" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudNumericField id="settings-available-cash" T="decimal" @bind-Value="_s.CashAvailable" Label="Available cash" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
                <MudNumericField id="settings-monthly-investment" T="decimal" @bind-Value="_s.MonthlyInvestment" Label="Monthly investment" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
                <MudTextField id="settings-currency" @bind-Value="_s.BaseCurrency" Label="Currency" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.h6" Class="mb-2">Target allocation</MudText>
                <MudNumericField id="settings-etf-allocation" T="decimal" @bind-Value="_s.TargetAllocationEtf" Label="ETF %" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudNumericField id="settings-stocks-allocation" T="decimal" @bind-Value="_s.TargetAllocationStocks" Label="Stocks %" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
                <MudNumericField id="settings-cash-allocation" T="decimal" @bind-Value="_s.TargetAllocationCash" Label="Cash %" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
                <MudNumericField id="settings-soft-max-position" T="decimal" @bind-Value="_s.MaxIndividualPosition" Label="Soft max per position" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
                <MudNumericField id="settings-hard-max-position" T="decimal" @bind-Value="_s.HardMaxIndividualPosition" Label="Hard max per position" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.h6" Class="mb-2">Risk</MudText>
                <MudSelect id="settings-risk-profile" T="RiskProfile" @bind-Value="_s.RiskProfile" Label="Risk profile" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var rp in Enum.GetValues<RiskProfile>())
                    { <MudSelectItem Value="rp">@rp</MudSelectItem> }
                </MudSelect>
                <MudNumericField id="settings-risk-per-trade" T="decimal" @bind-Value="_s.RiskPerTradePct" Label="Risk per trade (fraction)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
                <MudNumericField id="settings-default-rr-target" T="decimal" @bind-Value="_s.DefaultRrTarget" Label="Default R:R target" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
                <MudNumericField id="settings-tech-exposure-limit" T="decimal" @bind-Value="_s.TechExposureLimit" Label="Tech exposure limit" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.h6" Class="mb-2">Market data</MudText>
                <MudTextField id="settings-market-data-provider" @bind-Value="_s.MarketDataProvider" Label="Provider (display)" Variant="Variant.Outlined" Margin="Margin.Dense" HelperText="Set the actual provider in appsettings (MarketData:Provider)." />
                <MudSwitch T="bool" @bind-Value="_s.AutoSyncMarketData" Label="Auto-sync" Color="Color.Primary" Class="mt-2" />
                <MudNumericField id="settings-auto-sync-interval" T="int" @bind-Value="_s.AutoSyncIntervalHours" Label="Auto-sync interval (h)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
            </MudItem>
            <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">Save settings</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>
}

@code {
    private Domain.Entities.UserSettings? _s;

    protected override async Task OnInitializedAsync()
    {
        var uid = await CurrentUser.GetUserIdAsync();
        if (uid is null) return;
        _s = await SettingsRepo.GetOrCreateAsync(uid);
    }

    private async Task SaveAsync()
    {
        if (_s is null) return;
        await SettingsRepo.UpdateAsync(_s);
        Snackbar.Add("Settings saved", MudBlazor.Severity.Success);
    }
}
