@page "/"
@attribute [Authorize]
@inject IPortfolioService Portfolio
@inject IRecommendationService Recommendations
@inject IRiskService Risk
@inject IMarketSyncService MarketSync
@inject CurrentUserAccessor CurrentUser

<PageTitle>Dashboard - TradePerso</PageTitle>

<MudText Typo="Typo.h4" Class="page-title">Dashboard</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_summary is not null)
{
    <MudGrid Spacing="3">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 metric-card">
                <MudText Typo="Typo.overline">Total value</MudText>
                <MudText Typo="Typo.h5" Class="kpi">@F(_summary.TotalCurrentValue + _summary.Current.CashValue)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 metric-card">
                <MudText Typo="Typo.overline">Invested</MudText>
                <MudText Typo="Typo.h5" Class="kpi">@F(_summary.TotalInvested)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 metric-card">
                <MudText Typo="Typo.overline">P&L</MudText>
                <MudText Typo="Typo.h5" Class="@($"kpi {(_summary.TotalPnl >= 0 ? "pnl-positive" : "pnl-negative")}")">
                    @F(_summary.TotalPnl) (@_summary.TotalPnlPct.ToString("P1"))
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 metric-card">
                <MudText Typo="Typo.overline">Cash</MudText>
                <MudText Typo="Typo.h5" Class="kpi">@F(_summary.Current.CashValue)</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4 metric-card">
                <MudText Typo="Typo.h6" Class="mb-2">Current allocation</MudText>
                @if (HasChartData(_allocationData))
                {
                    <MudChart ChartType="ChartType.Pie"
                              InputData="@_allocationData"
                              InputLabels="@_allocationLabels"
                              Width="100%"
                              Height="260px"
                              ChartOptions="@_pieChartOptions" />
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Dense="true">No invested value or cash to chart yet.</MudAlert>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="8">
            <MudPaper Class="pa-4 metric-card">
                <MudText Typo="Typo.h6">Allocation vs target</MudText>
                <MudChart ChartType="ChartType.Bar"
                          ChartSeries="@_allocationSeries"
                          XAxisLabels="@_allocationLabels"
                          Width="100%"
                          Height="280px"
                          ChartOptions="@_barChartOptions" />
                <MudSimpleTable Hover="true" Dense="true" Class="mt-2">
                    <thead><tr><th></th><th>Current</th><th>Target</th><th>Gap</th></tr></thead>
                    <tbody>
                        <tr><td>ETF</td><td>@_summary.Current.EtfWeight.ToString("P1")</td><td>@_summary.Target.EtfWeight.ToString("P0")</td><td>@_summary.Gap.EtfWeight.ToString("P1")</td></tr>
                        <tr><td>Stocks</td><td>@_summary.Current.StockWeight.ToString("P1")</td><td>@_summary.Target.StockWeight.ToString("P0")</td><td>@_summary.Gap.StockWeight.ToString("P1")</td></tr>
                        <tr><td>Cash</td><td>@_summary.Current.CashWeight.ToString("P1")</td><td>@_summary.Target.CashWeight.ToString("P0")</td><td>@_summary.Gap.CashWeight.ToString("P1")</td></tr>
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4 metric-card">
                <MudText Typo="Typo.h6" Class="mb-2">Sector exposure</MudText>
                @if (HasChartData(_sectorData))
                {
                    <MudChart ChartType="ChartType.Pie"
                              InputData="@_sectorData"
                              InputLabels="@_sectorLabels"
                              Width="100%"
                              Height="300px"
                              ChartOptions="@_pieChartOptions" />
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Dense="true">No sector exposure yet.</MudAlert>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4 metric-card">
                <MudText Typo="Typo.h6" Class="mb-2">Largest holdings</MudText>
                @if (_holdingSeries.Count > 0)
                {
                    <MudChart ChartType="ChartType.Bar"
                              ChartSeries="@_holdingSeries"
                              XAxisLabels="@_holdingLabels"
                              Width="100%"
                              Height="300px"
                              ChartOptions="@_barChartOptions" />
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Dense="true">Add positions to compare holding weights.</MudAlert>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4 metric-card">
                <MudText Typo="Typo.h6">Top picks today</MudText>
                @if (_topRecs.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mt-2">No actionable ideas at the moment.</MudText>
                }
                else
                {
                    @foreach (var r in _topRecs)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="my-2">
                            <MudChip T="string" Color="@PrudenceColor(r.Prudence)" Size="Size.Small">@r.Prudence</MudChip>
                            <MudText>@r.Ticker - @r.Name</MudText>
                            <MudSpacer />
                            <MudText Typo="Typo.body2">Score @r.Score.ToString("0.0")</MudText>
                        </MudStack>
                    }
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12">
            <MudPaper Class="pa-4 metric-card">
                <MudText Typo="Typo.h6" Class="mb-2">Risk alerts</MudText>
                @if (_alerts.Count == 0)
                {
                    <MudAlert Severity="Severity.Success" Dense="true">No alerts. Portfolio within guardrails.</MudAlert>
                }
                else
                {
                    @foreach (var a in _alerts)
                    {
                        <MudAlert Severity="@SeverityOf(a.Severity)" Dense="true" Class="mb-2">
                            <strong>@a.Title</strong>: @a.Message
                        </MudAlert>
                    }
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private bool _loading = true;
    private PortfolioSummaryDto? _summary;
    private IReadOnlyList<RecommendationDto> _topRecs = Array.Empty<RecommendationDto>();
    private IReadOnlyList<RiskAlertDto> _alerts = Array.Empty<RiskAlertDto>();
    private readonly string[] _allocationLabels = { "ETF", "Stocks", "Cash" };
    private double[] _allocationData = Array.Empty<double>();
    private List<ChartSeries> _allocationSeries = new();
    private string[] _sectorLabels = Array.Empty<string>();
    private double[] _sectorData = Array.Empty<double>();
    private string[] _holdingLabels = Array.Empty<string>();
    private List<ChartSeries> _holdingSeries = new();

    private readonly ChartOptions _pieChartOptions = new()
    {
        MaxNumYAxisTicks = 5
    };

    private readonly ChartOptions _barChartOptions = new()
    {
        MaxNumYAxisTicks = 5,
        LineStrokeWidth = 3
    };

    protected override async Task OnInitializedAsync()
    {
        var userId = await CurrentUser.GetUserIdAsync();
        if (userId is null) return;
        await MarketSync.MaybeAutoSyncAsync(userId);
        _summary = await Portfolio.ComputeSummaryAsync(userId);
        var recs = await Recommendations.GenerateAsync(userId);
        _topRecs = recs.Where(r => r.Prudence is PrudenceLevel.Interesting or PrudenceLevel.Watch).Take(5).ToList();
        _alerts = await Risk.EvaluateAsync(userId);
        BuildCharts(_summary);
        _loading = false;
    }

    private static string F(decimal v) => v.ToString("N2");
    private void BuildCharts(PortfolioSummaryDto summary)
    {
        _allocationData = new[]
        {
            D(summary.Current.EtfWeight * 100m),
            D(summary.Current.StockWeight * 100m),
            D(summary.Current.CashWeight * 100m),
        };

        _allocationSeries = new List<ChartSeries>
        {
            new()
            {
                Name = "Current",
                Data = new[]
                {
                    D(summary.Current.EtfWeight * 100m),
                    D(summary.Current.StockWeight * 100m),
                    D(summary.Current.CashWeight * 100m),
                }
            },
            new()
            {
                Name = "Target",
                Data = new[]
                {
                    D(summary.Target.EtfWeight * 100m),
                    D(summary.Target.StockWeight * 100m),
                    D(summary.Target.CashWeight * 100m),
                }
            },
        };

        var sectors = summary.SectorExposure
            .OrderByDescending(kv => kv.Value)
            .Take(6)
            .ToList();

        _sectorLabels = sectors.Select(kv => kv.Key).ToArray();
        _sectorData = sectors.Select(kv => D(kv.Value * 100m)).ToArray();

        var holdings = summary.Positions
            .OrderByDescending(p => p.CurrentValue)
            .Take(8)
            .ToList();

        _holdingLabels = holdings.Select(p => p.Ticker).ToArray();
        _holdingSeries = holdings.Count == 0
            ? new List<ChartSeries>()
            : new List<ChartSeries>
            {
                new()
                {
                    Name = "Current value",
                    Data = holdings.Select(p => D(p.CurrentValue)).ToArray()
                }
            };
    }

    private static bool HasChartData(IEnumerable<double> values) => values.Any(v => v > 0.0001d);
    private static double D(decimal value) => decimal.ToDouble(value);

    private static Color PrudenceColor(PrudenceLevel p) => p switch
    {
        PrudenceLevel.Interesting => Color.Success,
        PrudenceLevel.Watch => Color.Info,
        PrudenceLevel.Wait => Color.Warning,
        _ => Color.Error
    };
    private static Severity SeverityOf(string s) => s switch
    {
        "error" => Severity.Error,
        "warning" => Severity.Warning,
        "info" => Severity.Info,
        _ => Severity.Normal
    };
}
